# =============================================================================
# 复制本文件为同目录下的 .env 后填写真实值：
#   copy .env.example .env
# 不要将 .env 提交到 Git。下列等号右侧均为占位说明，不是生产默认配置。
# =============================================================================

# ----- OpenAI 兼容聊天 API（backend/app/services/ai_service.py）-----
# 调用大模型时需要；缺失时客户端可能在请求阶段失败。
AI_API_KEY=sk-your-key-here
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=your-model-name

# ----- JWT（backend/app/core/security.py）-----
# 启动时必填：缺失、过短（<32 字符）或仍为常见占位值会导致服务无法导入。
# 请自行生成足够长的随机字符串，例如 PowerShell：
#   [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Maximum 256}) -as [byte[]])
# 不要使用 your-super-secret-key / changeme / secret 等弱占位值。
# You MUST generate your own random secret of at least 32 characters.
# Do NOT use placeholders, sample strings, or copy any example value as the real key.
JWT_SECRET_KEY=

# ----- 首次管理员（backend/app/services/user_seed.py）-----
# 仅当 SQLite 中还不存在用户名为 admin 的账号时需要。
# 已存在 admin 时：不要依赖本变量；启动不会覆盖已有密码。
# 禁止使用 123456 / password / admin / admin123 等弱口令（代码会拒绝）。
# 若 admin 已存在，可保持注释状态。
# ADMIN_INITIAL_PASSWORD=replace-with-a-strong-initial-password
